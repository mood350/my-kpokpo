spring.application.name=Backend
server.port=8080

# --- Base de donnees PostgreSQL ---
spring.datasource.url=${DB_URL:jdbc:postgresql://localhost:5432/kpokpo_db}
spring.datasource.username=${DB_USER:your_db_user}
spring.datasource.password=${DB_PASSWORD:your_db_password}
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.open-in-view=false

# --- JWT ---
# Generer avec : openssl rand -base64 64  puis exporter JWT_SECRET_KEY=<valeur>
application.security.jwt.secret-key=${JWT_SECRET_KEY:CHANGE_ME_generate_with_openssl_rand_-base64_64}
# Access token : 15 minutes (en ms)
application.security.jwt.expiration=900000
# Refresh token : 7 jours (en ms)
application.security.jwt.refresh-token-expiration=604800000

# --- Email (Gmail SMTP) ---
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=${MAIL_USERNAME:your_email@gmail.com}
spring.mail.password=${MAIL_PASSWORD:your_gmail_app_password}
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true
application.mail.from=no-reply@kpokpo.com

# --- URL frontend pour le lien d'activation ---
application.mailing.frontend.activation-url=http://localhost:3000/activate

# --- Rate limiting (Bucket4j) ---
app.rate-limit.auth.capacity=10
app.rate-limit.api.capacity=100

# --- Logging ---
logging.level.org.springframework.security.config.annotation.authentication.configuration.InitializeUserDetailsBeanManagerConfigurer=ERROR
logging.level.org.springdoc.core.events.SpringDocAppInitializer=ERROR
