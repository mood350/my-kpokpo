# Copier ce fichier en .env et remplir les valeurs
# Ne jamais committer .env dans git

# Clé JWT — générer avec : openssl rand -base64 64
JWT_SECRET_KEY=

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/kpokpo_db
DB_USER=root
DB_PASSWORD=root

# Gmail SMTP (utiliser un mot de passe d'application Google, pas le mot de passe du compte)
MAIL_USERNAME=votre-adresse@gmail.com
MAIL_PASSWORD=
